# Copy this file to .env.docker for local development only.
# Never commit real credentials or reuse production values.
DATABASE_URL=postgresql+asyncpg://platform:CHANGE_ME@db:5432/buildplatform
DATABASE_URL_SYNC=postgresql://platform:CHANGE_ME@db:5432/buildplatform
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
APP_ENV=development
APP_DEBUG=false
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=CHANGE_ME_WITH_A_UNIQUE_PASSWORD
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=local-model-name
MAX_UPLOAD_SIZE_MB=50
TEMP_UPLOAD_DIR=/tmp/uploads
MODULE1_REF_RUNTIME_MODE=legacy
MODULE1_REF45_MODE=legacy
MODULE1_REF6_MODE=legacy