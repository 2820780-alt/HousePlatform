  "compatibilityRules": [
    {
      "context": "plaster",
      "material": "gypsum_plaster",
      "substrate": "gas_block",
      "status": "allowed",
      "requiredAdditionalResources": [
        "deep_penetration_primer"
      ],
      "explanation": "Газоблок требует грунтовки глубокого проникновения перед штукатуркой."
    },
    {
      "context": "plaster",
      "material": "gypsum_plaster",
      "substrate": "smooth_concrete",
      "status": "warning",
      "requiredAdditionalResources": [
        "adhesion_primer",
        "concrete_contact"
      ],
      "explanation": "Гладкий бетон требует адгезионной подготовки."
    },
    {
      "context": "bathroom_tile",
      "material": "wall_tile",
      "status": "allowed",
      "requiredAdditionalResources": [
        "liquid_waterproofing",
        "waterproofing_tape"
      ],
      "explanation": "Мокрые зоны требуют гидроизоляции."
    },
    {
      "context": "wet_zone",
      "material": "gypsum_board_regular",
      "status": "forbidden",
      "explanation": "Обычный ГКЛ нельзя использовать в мокрых зонах."
    },
    {
      "context": "metal_tile_roof",
      "material": "metal_tile",
      "status": "allowed",
      "requiredAdditionalResources": [
        "batten",
        "counter_batten",
        "windproof_membrane",
        "roofing_fastener"
      ],
      "explanation": "Металлочерепица требует кровельного пирога и fastening pattern."
    },
    {
      "context": "flexible_shingle_roof",
      "material": "flexible_shingle",
      "status": "allowed",
      "requiredAdditionalResources": [
        "osb_board",
        "roofing_underlayment",
        "roofing_nail"
      ],
      "explanation": "Мягкая кровля требует сплошного основания и подкладочного ковра."
    }
  ],
  "alternativeRules": [
    {
      "from": "gypsum_plaster",
      "to": "cement_plaster",
      "type": "conditional_alternative",
      "recalculationRequired": true,
      "technologyChangeRequired": false,
      "condition": "depends_on_room_and_substrate"
    },
    {
      "from": "gypsum_board_regular",
      "to": "gypsum_board_moisture_resistant",
      "type": "technical_alternative",
      "recalculationRequired": false,
      "technologyChangeRequired": false,
      "condition": "wet_room_or_higher_requirement"
    },
    {
      "from": "gypsum_board_moisture_resistant",
      "to": "gypsum_board_regular",
      "type": "forbidden_replacement",
      "recalculationRequired": false,
      "technologyChangeRequired": false,
      "condition": "wet_zone"
    },
    {
      "from": "xps_board",
      "to": "eps_board",
      "type": "conditional_alternative",
      "recalculationRequired": true,
      "technologyChangeRequired": false,
      "condition": "not_foundation_or_high_moisture_or_high_load"
    },
    {
      "from": "cement_screed",
      "to": "dry_screed",
      "type": "functional_alternative",
      "recalculationRequired": true,
      "technologyChangeRequired": true,
      "condition": "user_changes_floor_technology"
    }
  ],
  "unitConversions": [
    {
      "group": "rebar",
      "from": "m",
      "to": "kg",
      "formula": "length_m * kg_per_meter",
      "fallback": "diameter_mm^2 / 162"
    },
    {
      "group": "board",
      "from": "piece",
      "to": "m3",
      "formula": "thickness_m * width_m * length_m * pieces"
    },
    {
      "group": "aerated_concrete_block",
      "from": "piece",
      "to": "m3",
      "formula": "length_m * width_m * height_m * pieces"
    },
    {
      "group": "gypsum_board",
      "from": "sheet",
      "to": "m2",
      "formula": "length_m * width_m * sheets"
    },
    {
      "group": "membrane",
      "from": "roll",
      "to": "m2",
      "formula": "roll_width_m * roll_length_m * rolls"
    },
    {
      "group": "dry_mix",
      "from": "m2_mm",
      "to": "kg",
      "formula": "area_m2 * thickness_mm * consumption_kg_m2_mm"
    },
    {
      "group": "paint",
      "from": "m2",
      "to": "l",
      "formula": "area_m2 * coats / coverage_m2_per_l"
    }
  ]
}